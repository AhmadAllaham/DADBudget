rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return isSignedIn()
        && request.auth.uid == 'PST3chwdZmaQGeG25t4ym9Vlixe2';
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasDepartment(fundCenter) {
      return hasUserProfile()
        && currentUserProfile().departments is list
        && fundCenter in currentUserProfile().departments;
    }

    function isExecutiveViewer() {
      return hasUserProfile()
        && currentUserProfile().enabled != false
        && (currentUserProfile().role == 'executive_viewer'
            || (currentUserProfile().modules is list
                && 'executive' in currentUserProfile().modules));
    }

    function hasModule(moduleName) {
      return hasUserProfile()
        && currentUserProfile().enabled != false
        && currentUserProfile().modules is list
        && moduleName in currentUserProfile().modules;
    }

    function isCapexItViewer() {
      return hasModule('capex_it');
    }

    function isHrPlanner() {
      return hasModule('hr');
    }

    function isHrItViewer() {
      return hasModule('hr_it');
    }

    function isManager() {
      return hasUserProfile()
        && currentUserProfile().enabled != false
        && currentUserProfile().role == 'manager';
    }

    function isAssignedManager(fundCenter) {
      return isManager()
        && hasDepartment(fundCenter)
        && ('managerUid' in resource.data)
        && resource.data.managerUid == request.auth.uid;
    }

    function hasConfiguredManager(fundCenter) {
      return exists(/databases/$(database)/documents/budget_submission_status/$(fundCenter))
        && get(/databases/$(database)/documents/budget_submission_status/$(fundCenter)).data.managerUid is string
        && get(/databases/$(database)/documents/budget_submission_status/$(fundCenter)).data.managerUid != '';
    }

    function configuredManagerUid(fundCenter) {
      return get(/databases/$(database)/documents/budget_submission_status/$(fundCenter)).data.managerUid;
    }

    function isConfiguredManagerFor(fundCenter) {
      return isSignedIn()
        && hasConfiguredManager(fundCenter)
        && configuredManagerUid(fundCenter) == request.auth.uid;
    }

    function validCapexItMirror(fundCenter) {
      return request.resource.data.keys().hasOnly([
          'cc',
          'departmentName',
          'rows',
          'payments',
          'total',
          'paymentTotal',
          'sourceFile',
          'sourceRevision',
          'updatedBy',
          'updatedByEmail',
          'updatedAt'
        ])
        && request.resource.data.cc == fundCenter
        && request.resource.data.departmentName is string
        && request.resource.data.rows is list
        && request.resource.data.payments is list
        && request.resource.data.total is number
        && request.resource.data.paymentTotal is number
        && request.resource.data.sourceFile is string
        && request.resource.data.sourceRevision is int
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email;
    }

    function validItBudgetPlan() {
      return request.resource.data.keys().hasOnly([
          'fiscalYear',
          'sheets',
          'revision',
          'sourceFile',
          'updatedBy',
          'updatedByEmail',
          'updatedAt',
          'clientUpdatedAt'
        ])
        && request.resource.data.fiscalYear == 2027
        && request.resource.data.sheets is map
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.sourceFile is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email
        && request.resource.data.clientUpdatedAt is string;
    }

    function validHrHeadcount(fundCenter) {
      return request.resource.data.keys().hasOnly([
          'cc',
          'departmentName',
          'currentEmployees',
          'newHeadcount',
          'replacement',
          'paidTrainees',
          'unpaidTrainees',
          'details',
          'sourceFile',
          'updatedBy',
          'updatedByEmail',
          'updatedAt'
        ])
        && request.resource.data.cc == fundCenter
        && request.resource.data.departmentName is string
        && request.resource.data.currentEmployees is int
        && request.resource.data.currentEmployees >= 0
        && request.resource.data.newHeadcount is int
        && request.resource.data.newHeadcount >= 0
        && request.resource.data.replacement is int
        && request.resource.data.replacement >= 0
        && request.resource.data.paidTrainees is int
        && request.resource.data.paidTrainees >= 0
        && request.resource.data.unpaidTrainees is int
        && request.resource.data.unpaidTrainees >= 0
        && request.resource.data.details is list
        && request.resource.data.sourceFile is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email;
    }

    function validDepartmentNextState(fundCenter) {
      return request.resource.data.workflowStatus == 'uploaded'
        || (request.resource.data.workflowStatus == 'pending_manager'
            && hasConfiguredManager(fundCenter)
            && request.resource.data.managerUid == configuredManagerUid(fundCenter)
            && configuredManagerUid(fundCenter) != request.auth.uid)
        || (request.resource.data.workflowStatus == 'under_review'
            && (!hasConfiguredManager(fundCenter)
                || configuredManagerUid(fundCenter) == request.auth.uid));
    }

    function departmentSubmissionIsOpen() {
      return !('workflowStatus' in resource.data)
        || resource.data.workflowStatus == 'uploaded'
        || resource.data.workflowStatus == 'manager_returned'
        || resource.data.workflowStatus == 'returned';
    }

    function validManagerDecision() {
      return resource.data.workflowStatus == 'pending_manager'
        && request.resource.data.workflowStatus in ['manager_approved', 'manager_returned']
        && request.resource.data.managerDecisionBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workflowStatus',
          'status',
          'financeStatus',
          'managerStatus',
          'managerNote',
          'managerReturnedRevision',
          'managerApprovedAt',
          'managerApprovedBy',
          'managerApprovedByEmail',
          'managerDecisionAt',
          'managerDecisionBy',
          'managerDecisionEmail',
          'workflowUpdatedAt'
        ]);
    }

    function validManagerOpexRevision() {
      return resource.data.workflowStatus == 'pending_manager'
        && request.resource.data.workflowStatus == 'pending_manager'
        && request.resource.data.managerEditedBy == request.auth.uid
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'encoding',
          'payload',
          'travelBudgetByGl',
          'fileName',
          'revision',
          'managerEditedAt',
          'managerEditedBy',
          'managerEditedByEmail',
          'workflowUpdatedAt'
        ]);
    }

    function validManagerCapexRevision() {
      return resource.data.workflowStatus == 'pending_manager'
        && request.resource.data.workflowStatus == 'pending_manager'
        && request.resource.data.status == 'pending_manager'
        && request.resource.data.managerEditedBy == request.auth.uid
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rows',
          'total',
          'fileName',
          'revision',
          'managerEditedAt',
          'managerEditedBy',
          'managerEditedByEmail',
          'workflowUpdatedAt'
        ]);
    }

    function myEmail() {
      return request.auth.token.email;
    }

    function submissionIsApproved() {
      return ('workflowStatus' in resource.data)
        && resource.data.workflowStatus == 'approved';
    }

    match /system_status/{document} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, create, update, delete: if isMainAdmin();
      allow read: if isSignedIn() && request.auth.uid == userId;
    }

    match /opex_baseline_meta/{document} {
      allow read: if isSignedIn();
      allow create, update, delete: if isMainAdmin();
    }

    match /opex_baseline_departments/{fundCenter} {
      allow read: if isMainAdmin()
                  || isExecutiveViewer()
                  || isCapexItViewer()
                  || isHrPlanner()
                  || isHrItViewer()
                  || hasDepartment(fundCenter);
      allow create, update, delete: if isMainAdmin();
    }

    // =========================
    // HR HEADCOUNT
    // =========================

    match /hr_headcount/{fundCenter} {
      allow read: if isMainAdmin()
                  || isExecutiveViewer()
                  || isHrPlanner()
                  || isHrItViewer()
                  || hasDepartment(fundCenter);

      allow create, update: if validHrHeadcount(fundCenter)
                            && (isMainAdmin()
                                || isHrPlanner());

      allow delete: if false;
    }

    match /opex_budget_submissions/{fundCenter} {
      allow read: if isMainAdmin() || isExecutiveViewer() || hasDepartment(fundCenter);
      allow create: if isMainAdmin()
                    || (hasDepartment(fundCenter)
                        && request.resource.data.submittedBy == request.auth.uid
                        && validDepartmentNextState(fundCenter));
      allow update: if isMainAdmin()
                    || (isAssignedManager(fundCenter)
                        && (validManagerDecision()
                            || validManagerOpexRevision()))
                    || (hasDepartment(fundCenter)
                        && departmentSubmissionIsOpen()
                        && request.resource.data.submittedBy == request.auth.uid
                        && validDepartmentNextState(fundCenter));
      allow delete: if false;
    }

    match /capex_budget_submissions/{fundCenter} {
      allow read: if isMainAdmin() || isExecutiveViewer() || hasDepartment(fundCenter);
      allow create: if isMainAdmin()
                    || (hasDepartment(fundCenter)
                        && request.resource.data.submittedBy == request.auth.uid
                        && request.resource.data.status == request.resource.data.workflowStatus
                        && request.resource.data.workflowStatus != 'uploaded'
                        && validDepartmentNextState(fundCenter));
      allow update: if isMainAdmin()
                    || (isAssignedManager(fundCenter)
                        && (validManagerDecision()
                            || validManagerCapexRevision())
                        && request.resource.data.status == request.resource.data.workflowStatus)
                    || (hasDepartment(fundCenter)
                        && resource.data.workflowStatus in ['returned', 'manager_returned']
                        && request.resource.data.submittedBy == request.auth.uid
                        && request.resource.data.status == request.resource.data.workflowStatus
                        && request.resource.data.workflowStatus != 'uploaded'
                        && validDepartmentNextState(fundCenter));
      allow delete: if false;
    }

    // IT receives only the CAPEX rows copied from the two IT categories.
    // The original Fund Center remains the owner of every request.
    match /capex_it_requests/{fundCenter} {
      allow read: if isMainAdmin()
                  || isExecutiveViewer()
                  || isCapexItViewer()
                  || hasDepartment(fundCenter);

      allow create, update: if validCapexItMirror(fundCenter)
                            && (isMainAdmin()
                                || hasDepartment(fundCenter)
                                || isConfiguredManagerFor(fundCenter));

      allow delete: if false;
    }

    // =========================
    // IT OPERATING BUDGET 2027
    // =========================

    match /it_budget_plans/{planId} {
      allow read: if isMainAdmin()
                  || isExecutiveViewer()
                  || isCapexItViewer();

      allow create, update: if validItBudgetPlan()
                            && (isMainAdmin()
                                || isCapexItViewer());

      allow delete: if false;
    }

    match /budget_submission_status/{fundCenter} {
      allow read, create, update: if isMainAdmin();
      allow read: if isExecutiveViewer() || hasDepartment(fundCenter);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == myEmail()
        && request.resource.data.toEmail is string
        && request.resource.data.body is string
        && request.resource.data.subject is string;

      allow read: if isSignedIn()
        && (resource.data.fromEmail == myEmail()
            || resource.data.toEmail == myEmail());

      allow update: if isSignedIn()
        && resource.data.toEmail == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);

      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow read: if isMainAdmin();
      allow update, delete: if false;
    }

    match /audit_counters/{counterId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    match /mail/{mailId} {
      allow create: if isMainAdmin()
                    || (isSignedIn()
                        && request.resource.data.notificationType == 'budget_upload'
                        && request.resource.data.createdBy == request.auth.uid
                        && request.resource.data.createdByEmail == myEmail()
                        && request.resource.data.to is list
                        && request.resource.data.to.size() == 1
                        && request.resource.data.to[0] == 'allaham@dadgroup.com'
                        && request.resource.data.message is map
                        && request.resource.data.message.subject is string
                        && request.resource.data.message.text is string
                        && request.resource.data.message.html is string);
      allow read: if isMainAdmin();
      allow update, delete: if false;
    }
  }
}
